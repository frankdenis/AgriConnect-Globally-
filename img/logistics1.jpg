    font-family: 'Narziss';
    src: url('/fonts/NarzissProCyrillic.woff');
}

@font-face {
    font-family: 'Serifa';
    src: url('/fonts/SerifaBT.ttf');
}

html,
body.wrapper,
div,
p,
a,
h1,
h2,
h3,
h4,
h5,
h6,
span,
.story_content,
.story_content p {
    font-family: 'Serifa';
}

.meta_author_avatar {
    display: none;
}

.mode-change-wrap {
    display: block !important;
}

#footer {
    background: #ececec;
    margin-top: 10px;
}

#footer .widget h3 {
