/* read full story */
.details-story-wrapper-main.closed {
    max-height: 440px;
    overflow: hidden;
    margin-bottom: 20px;
}

.btn-mod.btn-color {
    color: #fff;
    background: rgb(185, 30, 34);
}

.btn-mod.btn-medium {
    height: auto;
    padding: 12px 35px;
    font-size: 14px;
    letter-spacing: 0;
}

.read-full-article.mt-10 {
    /* margin-bottom: 15px; */
    position: absolute;
    text-align: center;
}

.read-full-article-overlay {
    padding: 50px;
