.read-full-article {
    bottom: 0;
    height: 33px;
    left: 0;
    opacity: 1;
    z-index: 0;
    position: absolute;
    text-align: center;
    width: 100%;
    background: -webkit-linear-gradient(top, rgba(255, 255, 255, 0) 0, rgba(255, 255, 255, 0) 1%, rgba(255, 255, 255, .4) 25%, rgba(255, 255, 255, 1) 93%, rgba(255, 255, 255, 1) 100%);
    padding-top: 170px;
    padding-bottom: 35px;
    text-align: center;
}

ul.custom-new-social-box {
